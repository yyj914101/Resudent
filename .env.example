# run_server.py normally sets these paths automatically.
SHUCUN_DATA_DIR=C:/path/to/local/data
SHUCUN_DB_PATH=C:/path/to/local/data/data/shucun.db
SHUCUN_UPLOAD_DIR=C:/path/to/local/data/uploads
SHUCUN_BACKUP_DIR=C:/path/to/local/data/backups
SHUCUN_LICENSE_FILE=C:/path/to/local/data/license.key
SHUCUN_PORT=5000

# config.py can be updated to read this value before a public deployment.
SHUCUN_SECRET_KEY=replace-with-a-long-random-value
